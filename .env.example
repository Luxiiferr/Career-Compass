CAREERCOMPASS_SECRET_KEY=replace-with-a-long-random-secret
CAREERCOMPASS_SMTP_EMAIL=your-sender@gmail.com
CAREERCOMPASS_SMTP_APP_PASSWORD=your-gmail-app-password
CAREERCOMPASS_SMTP_HOST=smtp.gmail.com
CAREERCOMPASS_SMTP_PORT=465
# Leave unset locally to use careercompass.db. Set this on Render for PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
